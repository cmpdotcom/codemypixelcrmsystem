generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  roleId        String?
  teamId        String?
  status        String    @default("Active") // Active, Inactive
  lastActive    DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  team          Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams      Team[]    @relation("TeamLeader")

  @@index([roleId])
  @@index([teamId])
  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("blue") // blue, green, amber, purple, rose, slate
  permissions Json?    // matrix of module: { view, create, edit, del, assign }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  department  String   @default("Sales") // Sales, Delivery, Operations, etc.
  color       String   @default("blue")
  leaderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leader      User?    @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members     User[]   @relation("TeamMembers")

  @@index([department])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Lead {
  id          String    @id @default(cuid())
  leadNumber  Int       @unique @default(autoincrement())
  name        String
  company     String
  email       String
  phone       String?
  location    String?
  linkedin    String?
  source      String    @default("Website")
  service     String?
  status      String    @default("New")
  setter      String?
  setterImg   String?
  budget      String?
  timeline    String?
  companySize String?
  industry    String?
  lastContact DateTime?
  nextFollowUp DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activities  LeadActivity[]
  files       LeadFile[]
  crmActivities Activity[]
  deals       Deal[]
  followUps   FollowUp[]

  @@index([status])
  @@index([source])
  @@index([setter])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String   // Call, Email, Meeting, Note, WhatsApp, Other
  title     String
  description String?
  performedBy String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadFile {
  id        String   @id @default(cuid())
  leadId    String
  fileName  String
  fileSize  Int      @default(0)
  fileType  String?
  fileUrl   String
  uploadedBy String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  activityNumber Int  @unique @default(autoincrement())
  type        String   @default("Note")  // Call, Email, WhatsApp, Meeting, Note, Task, SMS, Other
  direction   String?  // Outbound, Inbound, Sent, Received, Internal, Online, In Person
  title       String
  description String?
  company     String?
  contact     String?
  leadId      String?
  performedBy String?
  status      String   @default("Completed") // Completed, Scheduled, Pending, Cancelled
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([performedBy])
  @@index([createdAt])
}

model Deal {
  id               String    @id @default(cuid())
  dealNumber       Int       @unique @default(autoincrement())
  title            String
  company          String
  contact          String?
  service          String?
  value            Float     @default(0)
  stage            String    @default("qualified") // qualified, discovery, proposal, negotiation, contract, won, lost
  pipeline         String    @default("Software Sales")
  probability      Int       @default(20)
  priority         String    @default("Medium") // Low, Medium, High, Urgent
  closer           String?
  closerImg        String?
  leadId           String?
  clientId         String?
  expectedCloseDate DateTime?
  closedAt         DateTime?
  lostReason       String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([pipeline])
  @@index([closer])
  @@index([clientId])
  @@index([createdAt])
}

model Client {
  id              String   @id @default(cuid())
  clientNumber    Int      @unique @default(autoincrement())
  company         String
  tagline         String?
  location        String?
  address         String?
  website         String?
  email           String
  phone           String?
  industry        String?  @default("Technology")
  companySize     String?  @default("50–200 employees")
  status          String   @default("Active") // Active, Inactive, Prospect, VIP, At Risk, Churned
  contactName     String?
  contactRole     String?
  contactEmail    String?
  contactPhone    String?
  contactImg      String?
  revenue         Float    @default(0)
  outstanding     Float    @default(0)
  projectsCount   Int      @default(0)
  clientSince     DateTime @default(now())
  lastActivity    DateTime? @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deals           Deal[]
  followUps       FollowUp[]
  projects        Project[]

  @@index([status])
  @@index([industry])
  @@index([createdAt])
}

model FollowUp {
  id           String    @id @default(cuid())
  fuNumber     Int       @unique @default(autoincrement())
  subjectTitle String
  subjectDesc  String?
  company      String
  contact      String?
  relatedRef   String?   // e.g. "Deal #DL-1082", "Lead #LD-2291"
  type         String    @default("Call") // Call, Email, Meeting, WhatsApp, SMS
  assigneeName String?
  dueDate      DateTime
  dueTime      String?   @default("11:00 AM")
  status       String    @default("Upcoming") // Due Today, Upcoming, Overdue, Completed
  priority     String    @default("Medium") // Low, Medium, High, Urgent
  completed    Boolean   @default(false)
  completedAt  DateTime?
  notes        String?
  leadId       String?
  clientId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@index([assigneeName])
}

model Project {
  id           String    @id @default(cuid())
  projNumber   Int       @unique @default(autoincrement())
  name         String
  clientName   String
  description  String?
  status       String    @default("Planning") // Planning, Requirements, Design, Development, Testing, Deployment, Completed, On Hold
  health       String    @default("on-track") // on-track, at-risk, critical
  progress     Int       @default(0) // 0 - 100
  budget       Float     @default(0)
  spent        Float     @default(0)
  startDate    DateTime  @default(now())
  deadline     DateTime
  teamMembers  String[]  // array of user initials or names
  leadId       String?
  clientId     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([status])
  @@index([health])
  @@index([deadline])
  @@index([clientId])
}

model Task {
  id             String    @id @default(cuid())
  taskNumber     Int       @unique @default(autoincrement())
  name           String
  description    String?
  projectName    String
  module         String?   @default("Core")
  assignee       String?   @default("Unassigned")
  priority       String    @default("Medium") // Urgent, High, Medium, Low
  status         String    @default("Todo") // Backlog, Todo, In Progress, Code Review, QA, Revision, Done, Blocked
  progress       Int       @default(0) // 0-100
  dueDate        DateTime
  startDate      DateTime? @default(now())
  estimatedHours Float     @default(8)
  loggedHours    Float     @default(0)
  tags           String[]
  blocked        Boolean   @default(false)
  projectId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([assignee])
  @@index([dueDate])
  @@index([projectId])
}
